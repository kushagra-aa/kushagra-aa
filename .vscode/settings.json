{
    "editor.codeActionsOnSave": {
        "source.addMissingImports.ts": "always",
        "source.fixAll.eslint": "always",
        "source.fixAll.prettier": "always",
        "source.organizeImports": "always",
        "source.fixAll": "explicit"
    },
    "eslint.validate": [
        "javascript",
        "typescript",
        "typescriptreact",
        "javascriptreact"
    ],
    "cSpell.words": [
        "anansi",
        "Astro",
        "behance",
        "flexbox",
        "flexbugs",
        "hashnode",
        "photoshop",
        "Rozgaar",
        "stackoverflow",
        "stylelint",
        "Tambola",
        "tauri",
        "Texzine",
        "Widdflix",
        "Widflixx",
        "Zustand"
    ],
}